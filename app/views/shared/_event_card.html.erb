<div class="card">
  <div class="header">
    <h3><%= link_to event.title, event_path(event) %></h3>
    <p class="date"><%= event.start_date.strftime("%b %d, %Y") %></p>
  </div>

  <div class="desc">
    <p><%= truncate(event.description, length: 150) %></p>
  </div>

  <div class="stats">
    <span>
      <span class="label">Upvotes:</span>
      <span class="val"><%= event.upvote_count %></span>
    </span>
    <span>
      <span class="label">Downvotes:</span>
      <span class="val"><%= event.downvote_count %></span>
    </span>
    <span>
      <span class="label">Score:</span>
      <span class="val <%= event.vote_score >= 0 ? 'pos' : 'neg' %>">
        <%= event.vote_score %>
      </span>
    </span>
  </div>

  <div class="actions">
    <%= link_to "View Details", event_path(event), class: "btn" %>
    
    <% if user_signed_in? %>
      <% user_vote = current_user.votes.find_by(event: event) %>
      <% if user_vote %>
        <span class="badge badge-<%= user_vote.vote_type %>">
          <%= user_vote.vote_type.capitalize %>
        </span>
      <% end %>
    <% end %>
  </div>
</div>

<style>
  .card {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 16px;
    background: white;
    transition: box-shadow 0.2s;
  }

  .card:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .header h3 {
    margin: 0 0 8px 0;
    font-size: 18px;
  }

  .header h3 a {
    color: #1a73e8;
    text-decoration: none;
  }

  .header h3 a:hover {
    text-decoration: underline;
  }

  .date {
    margin: 0;
    color: #666;
    font-size: 14px;
  }

  .desc {
    margin: 12px 0;
    color: #333;
    font-size: 14px;
  }

  .stats {
    display: flex;
    gap: 16px;
    margin: 12px 0;
    padding: 12px 0;
    border-top: 1px solid #f0f0f0;
    border-bottom: 1px solid #f0f0f0;
  }

  .stats span {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .label {
    font-size: 12px;
    color: #666;
  }

  .val {
    font-size: 18px;
    font-weight: bold;
    color: #1a73e8;
  }

  .val.pos {
    color: #34a853;
  }

  .val.neg {
    color: #ea4335;
  }

  .actions {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 12px;
  }

  .btn {
    padding: 8px 16px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 14px;
    background: #1a73e8;
    color: white;
    transition: background 0.2s;
  }

  .btn:hover {
    background: #1557b0;
  }

  .badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
  }

  .badge-upvote {
    background: #c6e3b5;
    color: #25802d;
  }

  .badge-downvote {
    background: #fce5e6;
    color: #d33b27;
  }
</style>
